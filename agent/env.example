# copy to .env and `source .env`, or export these directly.

# --- model provider ---
AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-key-here
AGENT_MODEL=deepseek/deepseek-chat-v3:free

# --- database (agent connects read-only) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kezzler
AGENT_USER=agent_ro
AGENT_PW=agent_ro_pw

# --- offline testing switches ---
# AGENT_FAKE_LLM=1     # canned responses, no key needed
# AGENT_SKIP_EXEC=1    # skip DB self-correction (no MySQL needed)
